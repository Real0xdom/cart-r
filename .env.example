# =====================================================
# CARTER - Environment Variables Example
# =====================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git!

# Supabase Configuration
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps API Keys
# Get from: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key
EXPO_PUBLIC_PLACES_API_KEY=your-google-maps-key
EXPO_PUBLIC_DIRECTIONS_API_KEY=your-google-maps-key

# Cashfree Payment Gateway (for customer payments)
# Get from: https://merchant.cashfree.com/merchants/pg-dashboard
EXPO_PUBLIC_CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENVIRONMENT=sandbox

# Cashfree Payouts Gateway (for driver withdrawals - DIFFERENT from Payment Gateway)
# Get from: https://merchant.cashfree.com/merchants/payouts
# Note: PG here means "Payouts Gateway", not "Payment Gateway"
CASHFREE_PG_APP_ID=your-payout-app-id
CASHFREE_PG_SECRET_KEY=your-payout-secret-key
CASHFREE_PG_ENV=sandbox

# Geoapify (for static map images)
# Get from: https://www.geoapify.com/
EXPO_PUBLIC_GEOAPIFY_API_KEY=your-geoapify-key

# Fast2SMS (for OTP delivery)
# Get from: https://www.fast2sms.com/
# Default: false - uses Fast2SMS. Set true to bypass and see OTP in console
EXPO_PUBLIC_BYPASS_SMS=false

# App Configuration
EXPO_PUBLIC_SERVER_URL=https://cart-r.com
