{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "node"],
    "paths": {
      "@customer/*": ["../apps/customer/*"],
      "@driver/*": ["../apps/driver/*"],
      "@admin/*": ["../apps/admin/*"]
    }
  },
  "include": ["./**/*.ts"]
}
