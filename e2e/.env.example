# ============================================================
# CARTR E2E Test Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Panel
ADMIN_URL=http://localhost:3000
ADMIN_EMAIL=admin@cartr.app
ADMIN_PASSWORD=your-admin-password

# Appium
APPIUM_HOST=localhost
APPIUM_PORT=4723
CUSTOMER_APK_PATH=../apps/customer/android/app/build/outputs/apk/debug/app-debug.apk
DRIVER_APK_PATH=../apps/driver/android/app/build/outputs/apk/debug/app-debug.apk

# Test Data
TEST_CUSTOMER_PHONE=+919999900001
TEST_DRIVER_PHONE=+919999900002
TEST_OTP=123456

# Environment
TEST_ENV=dev
CASHFREE_ENV=sandbox

# Optional: BrowserStack (cloud device farm)
# BROWSERSTACK_USERNAME=your-username
# BROWSERSTACK_ACCESS_KEY=your-key
