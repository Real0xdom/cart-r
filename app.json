{
  "expo": {
    "name": "Carter",
    "slug": "carter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "carter",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0286FF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carter.app",
      "config": {
        "googleMapsApiKey": "AIzaSyCfTI56S7y49YbdOyD76_8F0lUDRnSCBFU"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.carter.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCfTI56S7y49YbdOyD76_8F0lUDRnSCBFU"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://cart-r.com/"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Carter needs your location to show nearby drivers and track your deliveries."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
