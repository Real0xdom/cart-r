{
    "extends":  "expo/tsconfig.base",
    "compilerOptions":  {
                            "strict":  true,
                            "paths":  {
                                          "@/*":  [
                                                      "./*"
                                                  ]
                                      }
                        },
    "include":  [
                    "**/*.ts",
                    "**/*.tsx",
                    ".expo/types/**/*.ts",
                    "expo-env.d.ts"
                ],
    "exclude":  [
                    "mobile-tests",
                    "web-tests",
                    "configs/test-automation",
                    "scripts/test-automation"
                ]
}
